# Binance API Credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# Trading Config
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,ADA/USDT
RISK_PER_TRADE=0.02
MAX_DAILY_DRAWDOWN=0.20
POSITION_SIZE_USDT=100
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
TRAILING_STOP_ACTIVATE_PCT=0.05
TRAILING_STOP_DISTANCE_PCT=0.02

# Database
DATABASE_URL=sqlite:///data/trading.db

# Strategy
DEFAULT_STRATEGY=multi_signal_weighted
STRATEGY_INTERVAL_MINUTES=5

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/trading.log

# ML Model Path
XGBOOST_MODEL_PATH=crypto_trading/models/xgboost_model.json
